PORT=3000
DB_TYPE=sqlite
DB_DATABASE=./data/shift.sqlite
# 仅本机开发可设 true；false 时所有密钥和 seed 密码均执行生产强度校验
DEV_MODE=true
JWT_SECRET=dev-secret-change-me
# 用于 AES-GCM 加密保存虾推啥 Token；生产必须使用独立、随机、至少 32 字节的密钥
PUSH_ENCRYPTION_KEY=dev-push-encryption-key-change-me
# 同一公网出口共享一个标识，用于落实单 IP 限流；多实例必须配置成相同值
PUSH_EGRESS_KEY=default-egress
PUSH_SEND_TIMEOUT_SECONDS=10
PUSH_WORKER_INTERVAL_SECONDS=30
# 多个来源用英文逗号分隔；小程序请求通常无 Origin，后端已兼容
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
SEED_ON_BOOT=true
# 空库只 seed 一次；所有初始账号首次登录都会强制改密。
# 非 DEV_MODE 下若开启 seed，两个密码必须显式配置且至少 12 位。
# SEED_MANAGER_USERNAME=qqcxz
# SEED_MANAGER_PASSWORD=dev-manager-password
# SEED_STAFF_PASSWORD=dev-staff-password
# 排班历史默认建议保留月数（前端清理弹窗默认值）
SCHEDULE_KEEP_MONTHS=12
